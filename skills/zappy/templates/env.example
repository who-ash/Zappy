# Copy to zappy/.env (git-ignored) or put these in your project's .env.local / .env.
# Only the key for your tts.provider is needed.

# Default voice provider (tts.provider "sarvam"): https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Only if tts.provider is "openai"
# OPENAI_API_KEY=

# Optional: record a different URL than baseUrl in zappy.config.json
# ZAPPY_BASE_URL=http://localhost:3000
